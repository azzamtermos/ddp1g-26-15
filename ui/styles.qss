/* ==========================================================================
   Lembar Gaya Terpusat (QSS) - Smart File Organizer
   Mengikuti standar modern-pyqt-ux:
   - Latar utama: #F8FAFC
   - Permukaan kartu: #FFFFFF dengan border #E2E8F0
   - Tombol utama: #2563EB (hover #1D4ED8)
   - Sudut membulat: 8px (tombol/input), 12px (kartu/area utama)
   ========================================================================== */

QMainWindow, QWidget#CentralWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Segoe UI", "Inter", "Ubuntu", sans-serif;
    font-size: 13px;
}

/* Tipografi Judul & Label */
QLabel#AppTitleLabel {
    color: #0F172A;
    font-size: 20px;
    font-weight: bold;
}

QLabel#AppSubtitleLabel {
    color: #475569;
    font-size: 13px;
}

QLabel#DropZoneTitleLabel {
    color: #1E293B;
    font-size: 16px;
    font-weight: bold;
}

QLabel#DropZoneHintLabel {
    color: #64748B;
    font-size: 13px;
}

QLabel#SelectedFolderLabel {
    color: #2563EB;
    font-size: 13px;
    font-weight: bold;
}

QLabel#SummaryInfoLabel {
    color: #334155;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StatusProgressLabel {
    color: #475569;
    font-size: 13px;
}

/* Area Drag-and-Drop (DropZone) */
QFrame#DropZone {
    background-color: #FFFFFF;
    border: 2px dashed #94A3B8;
    border-radius: 12px;
    padding: 20px;
}

QFrame#DropZone[dragActive="true"] {
    background-color: #EFF6FF;
    border: 2px dashed #2563EB;
}

/* Kartu Ringkasan & Kontainer */
QFrame#SummaryCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 12px 16px;
}

/* Tombol Utama (Biru) */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #CBD5E1;
    color: #64748B;
}

/* Tombol Sekunder (Netral / Outline) */
QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#SecondaryButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton#SecondaryButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

/* Tombol Karantina ke Sampah (Oranye/Merah Lembut) */
QPushButton#QuarantineButton {
    background-color: #FFF7ED;
    color: #C2410C;
    border: 1px solid #FDBA74;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#QuarantineButton:hover {
    background-color: #FFEDD5;
    border-color: #FB923C;
}

QPushButton#QuarantineButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

/* Bar Progres (QProgressBar) */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #0F172A;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 6px;
}

/* Tabel Preview Rencana Perapian */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    gridline-color: #F1F5F9;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
    font-size: 13px;
    padding: 4px;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #F1F5F9;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #334155;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}
