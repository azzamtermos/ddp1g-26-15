/* ==========================================================================
   Lembar Gaya Terpusat (QSS) - Smart File Organizer
   Mengikuti standar modern-pyqt-ux:
   - Latar utama: #F8FAFC
   - Permukaan kartu: #FFFFFF dengan border #E2E8F0
   - Tombol utama: #2563EB (hover #1D4ED8)
   - Sudut membulat: 8px (tombol/input), 12px (kartu/area utama)
   ========================================================================== */

QMainWindow, QWidget#CentralWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Segoe UI", "Inter", "Ubuntu", sans-serif;
    font-size: 13px;
}

/* Tipografi Judul & Label */
QLabel#AppTitleLabel {
    color: #0F172A;
    font-size: 20px;
    font-weight: bold;
}

QLabel#AppSubtitleLabel {
    color: #475569;
    font-size: 13px;
}

QLabel#DropZoneTitleLabel {
    color: #1E293B;
    font-size: 16px;
    font-weight: bold;
}

QLabel#DropZoneHintLabel {
    color: #64748B;
    font-size: 13px;
}

QLabel#SelectedFolderLabel {
    color: #2563EB;
    font-size: 13px;
    font-weight: bold;
}

QLabel#SummaryInfoLabel {
    color: #334155;
    font-size: 13px;
    font-weight: 600;
}

QLabel#StatusProgressLabel {
    color: #475569;
    font-size: 13px;
}

/* Area Drag-and-Drop (DropZone) */
QFrame#DropZone {
    background-color: #FFFFFF;
    border: 2px dashed #94A3B8;
    border-radius: 12px;
    padding: 20px;
}

QFrame#DropZone[dragActive="true"] {
    background-color: #EFF6FF;
    border: 2px dashed #2563EB;
}

/* Kartu Ringkasan & Kontainer */
QFrame#SummaryCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 12px 16px;
}

/* Tombol Utama (Biru) */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #CBD5E1;
    color: #64748B;
}

/* Tombol Sekunder (Netral / Outline) */
QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#SecondaryButton:hover {
    background-color: #F1F5F9;
    border-color: #94A3B8;
}

QPushButton#SecondaryButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

/* Tombol Karantina ke Sampah (Oranye/Merah Lembut) */
QPushButton#QuarantineButton {
    background-color: #FFF7ED;
    color: #C2410C;
    border: 1px solid #FDBA74;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#QuarantineButton:hover {
    background-color: #FFEDD5;
    border-color: #FB923C;
}

QPushButton#QuarantineButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

/* Bar Progres (QProgressBar) */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #0F172A;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 6px;
}

/* Tabel Preview Rencana Perapian */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    gridline-color: #F1F5F9;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
    font-size: 13px;
    padding: 4px;
}

QTableWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #F1F5F9;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #334155;
    font-size: 13px;
    font-weight: bold;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

/* Banner Massal Usulan Rename */
QFrame#RenameBanner {
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    border-radius: 10px;
}

QLabel#RenameBannerLabel {
    color: #065F46;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
}

QPushButton#BannerAcceptAllButton {
    background-color: #16A34A;
    color: #FFFFFF;
    border: 1px solid #15803D;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#BannerAcceptAllButton:hover {
    background-color: #15803D;
}

QPushButton#BannerAcceptAllButton:disabled {
    background-color: #CBD5E1;
    color: #64748B;
    border-color: #CBD5E1;
}

QPushButton#BannerRejectAllButton {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#BannerRejectAllButton:hover {
    background-color: #FEF2F2;
    color: #DC2626;
    border-color: #FCA5A5;
}

QPushButton#BannerRejectAllButton:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
    border-color: #E2E8F0;
}

/* Sel Inline Usulan Rename & Checkbox di Tabel */
QWidget#CheckboxCellContainer,
QWidget#RenameCellContainer {
    background-color: transparent;
}

QWidget#CheckboxCellContainer[renameHighlighted="true"],
QWidget#RenameCellContainer[renameHighlighted="true"] {
    background-color: #ECFDF5;
}

QLabel#RenameTextLabel {
    background-color: transparent;
    font-size: 13px;
}

QPushButton#RenameAcceptButton {
    background-color: #FFFFFF;
    color: #16A34A;
    border: 1px solid #86EFAC;
    border-radius: 6px;
    padding: 2px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#RenameAcceptButton:hover {
    background-color: #DCFCE7;
}

QPushButton#RenameAcceptButton[active="true"] {
    background-color: #16A34A;
    color: #FFFFFF;
    border: 1px solid #15803D;
}

QPushButton#RenameAcceptButton[active="true"]:hover {
    background-color: #15803D;
}

QPushButton#RenameRejectButton {
    background-color: #FFFFFF;
    color: #64748B;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 2px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#RenameRejectButton:hover {
    background-color: #FEE2E2;
    color: #DC2626;
    border-color: #FCA5A5;
}

QPushButton#RenameRejectButton[active="true"] {
    background-color: #FEE2E2;
    color: #DC2626;
    border: 1px solid #F87171;
}

QPushButton#RenameRejectButton[active="true"]:hover {
    background-color: #FECACA;
}

/* Checkbox di Tabel */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #94A3B8;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QCheckBox::indicator:disabled {
    background-color: #E2E8F0;
    border-color: #CBD5E1;
}
