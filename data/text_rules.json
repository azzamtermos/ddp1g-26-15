{
  "generic_filename_patterns": [
    "^doc[-_]?\\d+.*$",
    "wa\\d{3,}",
    "^whatsapp[\\s_-]+(image|video|audio|document).*$",
    "^img[_-]?\\d+.*$",
    "^scan([\\s_-]*\\d+)*$",
    "^scan[\\s_-]*(dokumen|document|file|pdf)([\\s_-]*\\d+)*$",
    "^camscanner.*$",
    "^tapscanner.*$",
    "^untitled([\\s_-]*\\d*|\\s*\\(\\d+\\))?$",
    "^document([\\s_-]*\\d*|\\s*\\(\\d+\\))?$",
    "^new[\\s_-]+document([\\s_-]*\\d*|\\s*\\(\\d+\\))?$",
    "^download([\\s_-]*\\d*|\\s*\\(\\d+\\))?$",
    "^print([\\s_-]*\\d*|\\s*\\(\\d+\\))?$",
    "^screenshot([\\s_-]*\\d+.*)?$",
    "^file[\\s_-]*\\d+$",
    "^[\\d\\s_-]+$",
    "^[0-9a-f]{8,}$",
    "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  ],
  "document_title_whitelist": [
    "surat",
    "undangan",
    "keputusan",
    "edaran",
    "berita acara",
    "daftar hadir",
    "daftar nilai",
    "rekap",
    "jadwal",
    "rpp",
    "rencana pelaksanaan",
    "modul",
    "silabus",
    "materi",
    "soal",
    "ujian",
    "ulangan",
    "penilaian",
    "asesmen",
    "kisi-kisi",
    "sertifikat",
    "laporan",
    "lkpd",
    "kurikulum"
  ],
  "letterhead_filter_patterns": [
    "\\b(jl\\.|jalan)\\s+",
    "\\b(telp\\.?|telepon|fax\\.?|faks\\.?)\\b",
    "\\bkode\\s+pos\\b",
    "\\b(website|laman|www\\.|https?://)\\b",
    "\\b(e-?mail)\\b",
    "\\b(npsn|nss)\\b",
    "\\b(kecamatan|kelurahan|provinsi|kabupaten)\\b",
    "^\\s*(pemerintah|dinas|kementerian|kemendikbud|kemendikbudristek|yayasan|panitia)\\b",
    "^\\s*(nomor|no|lampiran|lamp|perihal|hal)\\s*:"
  ],
  "duplicate_markers": [
    "\\(\\d+\\)$",
    "[\\s_-]+copy(\\s*\\d*)?$",
    "[\\s_-]+salinan(\\s*\\d*)?$",
    "[\\s_-]+duplikat(\\s*\\d*)?$",
    "^copy\\s+of[\\s_-]+",
    "^salinan\\s+dari[\\s_-]+"
  ]
}
